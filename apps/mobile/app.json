{
  "expo": {
    "name": "Arku",
    "slug": "arku",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "arku",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Arku usa tu ubicación para encontrar la dirección de tu jardín y confirmar que está en nuestra zona de servicio."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Arku usa tus fotos para que puedas mostrar tu jardín y recibir una cotización más precisa.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}