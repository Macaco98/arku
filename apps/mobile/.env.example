# Copia este archivo como .env (no se sube al repositorio) para usar Supabase.
# Sin estas dos variables, la app usa el modo demostración con datos en el teléfono.
# Ambas están hechas para usarse dentro de la app (no son la clave de servicio).
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=tu-publishable-key
